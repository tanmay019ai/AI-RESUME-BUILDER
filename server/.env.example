PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/ai_resume_builder
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Gemini
GEMINI_API_KEY=your_gemini_api_key
# Optional: leave blank to auto-select a supported model for your key
GEMINI_MODEL=
# Optional: set true to bypass Gemini and generate a mock resume JSON (dev/demo)
GEMINI_MOCK=false

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
PRO_PLAN_AMOUNT_PAISE=19900
PRO_PLAN_CURRENCY=INR

# Rate limiting
GENERATE_RL_WINDOW_MS=900000
GENERATE_RL_MAX=10
